# Copy to `.env` and adjust for your environment.

# --- General ---
APP_NAME=Smart Meeting
ENVIRONMENT=development
DEBUG=true

# --- Security (CHANGE IN PRODUCTION) ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# --- Database ---
# SQLite (default):
DATABASE_URL=sqlite:///./smart_meeting.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/smartmeeting

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---
AUDIO_STORAGE_DIR=./data/audio
# Redis memory store for live PCM + cached WAV audio
REDIS_URL=redis://127.0.0.1:6379/0
# How long meeting audio keys live in Redis (seconds). 0 = no expiry.
# Full PCM is on disk; Redis only keeps a rolling recent window + meta/WAV.
REDIS_AUDIO_TTL_SECONDS=86400
# Seconds of recent PCM kept in Redis for reconnect assist (~3 min).
REDIS_LIVE_BUFFER_SECONDS=180
# Soft cap for one live recording (hours). Raise for longer sessions.
MAX_MEETING_HOURS=16
# Finalize abandoned live sessions after this idle time (seconds).
ABANDONED_SESSION_SECONDS=300
SESSION_JANITOR_INTERVAL_SECONDS=60
# Drop live ASR windows when backlog exceeds this many hops.
LIVE_ASR_MAX_BACKLOG_WINDOWS=12
# Partial catch-up skips (avoid jumping to live edge and losing captions).
LIVE_ASR_BACKPRESSURE_SKIP_HOPS=2
# Final Whisper ASR chunking for multi-hour audio
WHISPER_FINAL_CHUNK_SECONDS=600
WHISPER_FINAL_CHUNK_OVERLAP_SECONDS=15
# Persist every Nth live window to SQLite (12 ≈ once/minute at 5s hop)
LIVE_SEGMENT_PERSIST_EVERY=12
# WebSocket keepalive so proxies don't drop long sessions
WS_KEEPALIVE_SECONDS=25
# Max loaded Whisper backends (LRU). Live+final typically need 2.
WHISPER_MODEL_CACHE_SIZE=2
# Prefer live captions when final_words < live_words * ratio (and live is long enough).
LIVE_CAPTION_PREFER_RATIO=0.6
LIVE_CAPTION_PREFER_MIN_WORDS=12
# ffmpeg decode timeout for non-WAV uploads (seconds)
FFMPEG_TIMEOUT_SECONDS=120

# --- Audio ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# --- Whisper (two-pass) ---
# Prefer int8 on CPU for the live faster-whisper model.
# For GPU: WHISPER_DEVICE=cuda WHISPER_COMPUTE_TYPE=float16
# Hiligaynon has no native Whisper token — see docs/FINE_TUNE_HILIGAYNON.md
# Tagalog/Filipino uses Whisper's native ``tl`` token + Tagalog HF models.
WHISPER_LIVE_MODEL=small
WHISPER_FINAL_MODEL=medium
# Final ASR backend: auto | huggingface | faster-whisper
# auto = prefer HF PH/Tagalog/Hiligaynon candidates for those meetings
WHISPER_FINAL_BACKEND=auto
# Your fine-tuned Hiligaynon Whisper (HF repo or local path) — required for HF path
WHISPER_HILIGAYNON_FINE_TUNED_MODEL=
# Philippine HF model (Tagalog fallback / legacy). Not used for Hiligaynon final
# ASR unless a Hiligaynon fine-tune is also set — generic PH medium hallucinates
# on quiet Ilonggo board audio; Hiligaynon defaults to faster-whisper + amplify.
WHISPER_HILIGAYNON_MODEL=rbcurzon/whisper-medium-ph
# Optional CTranslate2 export of your Hiligaynon fine-tune for live captions
WHISPER_LIVE_HILIGAYNON_MODEL=
# Your Tagalog fine-tune (HF/local) — tried first for tl/fil meetings
WHISPER_TAGALOG_FINE_TUNED_MODEL=
# Tagalog-focused HF model (FLEURS fil_ph) for Stop Recording
WHISPER_TAGALOG_MODEL=LWobole/whisper-small-tagalog
# Optional CT2 Tagalog fine-tune for live captions
WHISPER_LIVE_TAGALOG_MODEL=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Meeting language default. ``hil`` = Hiligaynon-biased ASR (Whisper has no hil
# token; app uses tl decode + Hiligaynon prompt/model). Meeting ``auto`` also
# resolves to this default at transcription time.
WHISPER_DEFAULT_LANGUAGE=hil
# Coverage / forced decode code (hil has no Whisper token).
WHISPER_DECODE_LANGUAGE=tl
WHISPER_INITIAL_PROMPT=Board meeting discussion in Hiligaynon (Ilonggo), Filipino Tagalog, and English.
WHISPER_TAGALOG_INITIAL_PROMPT=Talakayan sa board meeting sa Tagalog at English. Filipino at English speech.
# Final pass language: auto | forced | prefer_forced
# prefer_forced = forced tl first, auto retry if coverage is poor (Iloilo default).
WHISPER_FINAL_LANGUAGE_MODE=prefer_forced
# Only if language is explicitly Tagalog (API/legacy).
WHISPER_TAGALOG_FINAL_LANGUAGE_MODE=prefer_forced
WHISPER_FINAL_VAD_FILTER=false
WHISPER_FINAL_MIN_COVERAGE=0.55
# Live caption windowing: 10s buffer overlapping by 5s.
WHISPER_LIVE_WINDOW_SECONDS=10.0
WHISPER_LIVE_HOP_SECONDS=5.0
# Quick first caption so Start recording feels responsive.
WHISPER_LIVE_WARMUP_SECONDS=2.5

# --- LLM (BART / mBART) ---
BART_MODEL=facebook/bart-large-cnn
MBART_MODEL=facebook/mbart-large-50-many-to-many-mmt
# Optional merged PH fine-tune (see docs/FINE_TUNE_MBART_PH.md)
# MBART_PH_FINE_TUNED_MODEL=/path/to/models/mbart-ph-en-merged
# auto | nllb | mbart
PH_TRANSLATE_BACKEND=auto
ALLOW_LLM_FALLBACK=true
# Topic-aware BART: chunk long transcripts before summarizing.
BART_MAX_INPUT_TOKENS=960
BART_TOPIC_SIMILARITY_THRESHOLD=0.22
BART_TOPIC_MIN_UNITS=2

# --- Rate limiting ---
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_AI=30/minute
