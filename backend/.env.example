# Copy to `.env` and adjust for your environment.

# --- General ---
APP_NAME=Smart Meeting
ENVIRONMENT=development
DEBUG=true

# --- Security (CHANGE IN PRODUCTION) ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# --- Database ---
# SQLite (default):
DATABASE_URL=sqlite:///./smart_meeting.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/smartmeeting

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---
AUDIO_STORAGE_DIR=./data/audio
# Redis memory store for live PCM + cached WAV audio
REDIS_URL=redis://127.0.0.1:6379/0
# How long meeting audio keys live in Redis (seconds). 0 = no expiry.
# 48h covers all-day board meetings (8h+) plus wrap-up.
REDIS_AUDIO_TTL_SECONDS=172800
# Soft cap for one live recording (hours). Raise for longer sessions.
MAX_MEETING_HOURS=16
# Final Whisper ASR chunking for multi-hour audio
WHISPER_FINAL_CHUNK_SECONDS=600
WHISPER_FINAL_CHUNK_OVERLAP_SECONDS=15
# Persist every Nth live window to SQLite (12 ≈ once/minute at 5s hop)
LIVE_SEGMENT_PERSIST_EVERY=12
# WebSocket keepalive so proxies don't drop long sessions
WS_KEEPALIVE_SECONDS=25

# --- Audio ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# --- Whisper (two-pass) ---
# Prefer int8 on CPU for the live faster-whisper model.
# Final pass loads a Hugging Face fine-tuned Whisper via transformers.
# For GPU: WHISPER_DEVICE=cuda WHISPER_COMPUTE_TYPE=float16
WHISPER_LIVE_MODEL=small
WHISPER_FINAL_MODEL=medium
# Fine-tuned Hiligaynon / PH Whisper used on Stop Recording.
# Point this at your own HF repo or local fine-tune when available.
WHISPER_HILIGAYNON_MODEL=rbcurzon/whisper-medium-ph
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Meeting language label. Whisper decode always uses language=tl + task=transcribe.
WHISPER_DEFAULT_LANGUAGE=hil
# Live caption windowing: 10s buffer overlapping by 5s.
WHISPER_LIVE_WINDOW_SECONDS=10.0
WHISPER_LIVE_HOP_SECONDS=5.0

# --- LLM (BART / mBART) ---
BART_MODEL=facebook/bart-large-cnn
MBART_MODEL=facebook/mbart-large-50-many-to-many-mmt
ALLOW_LLM_FALLBACK=true

# --- Rate limiting ---
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_AI=30/minute
