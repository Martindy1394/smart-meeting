{
  "name": "smart-meeting-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:models": "node -e \"const fs=require('fs');const m=fs.readFileSync('src/types/models.ts','utf8');for (const k of ['start_time','end_time','low_confidence','extractive_fallback','faithfulness','custom_vocab','action_items']){if(!m.includes(k)){console.error('missing '+k);process.exit(1)}};console.log('models.ts OK')\"",
    "generate:types": "bash ../scripts/generate-frontend-types.sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^6.0.5"
  }
}
